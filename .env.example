# Example only: environment variables are NOT auto-loaded.
ADMIN_KEY=replace-with-a-long-random-secret
ALLOWED_STREAM_HOSTS=your-trusted-hls-provider.example
MAX_STREAMS=1
MAX_UPLOAD_MB=150
MAX_VIDEO_SECONDS=1200
MAX_CLIPS_PER_UPLOAD=3
HIGHLIGHT_THRESHOLD=42
ENABLE_TRANSCRIPTION=0
WHISPER_MODEL=tiny

# Video editing (captions require faster-whisper + FFmpeg libass)
EDIT_PRESET=clean
BURN_SUBTITLES=0
